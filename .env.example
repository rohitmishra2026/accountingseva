# ─────────────────────────────────────────────────────────────────────────
# AccountingSeva — environment variables
# Copy this file to `.env.local` for local dev and fill in real values.
# NEVER commit `.env.local` or any file with real secrets.
# ─────────────────────────────────────────────────────────────────────────

# --- Supabase (public: safe to expose to the browser) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public API key (RLS-protected; safe in the client bundle).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRET: server-only, never sent to the browser) ---
# Service role key. Bypasses RLS. Used ONLY in server code (sync + admin).
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron / sync auth ---
# Shared secret guarding /api/sync. Sent by the Netlify scheduled function and by the admin
# "Run sync now" server action. Generate a long random string.
CRON_SECRET=

# --- Google Sheets service account (server-only) ---
# Service account email, e.g. sync-bot@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account private key. Keep the literal \n newlines when pasting into
# a dashboard; the code replaces \n with real newlines at runtime.
GOOGLE_PRIVATE_KEY=
# The Google Sheet ID (the long string in the sheet's URL).
SHEET_ID=

# --- Site ---
# Canonical public URL, used for SEO/OG tags and auth redirect URLs.
NEXT_PUBLIC_SITE_URL=https://accountingseva.in

# --- Sync configuration ---
# Comma-separated client emails to EXCLUDE from a sync. The Sheet keeps a
# test/dummy row alongside real clients; this is how it is filtered, so the
# denylist is configuration rather than something hardcoded in a component.
# Can differ between production and a preview deploy.
TEST_CLIENT_EMAILS=test@accountingseva.in

# --- RLS isolation test (npm run test:isolation) ---
# Two REAL client accounts on the target project. The test signs in as A and
# asserts it can see zero rows belonging to B. It FAILS rather than skips when
# these are unset, so a green unit run is never mistaken for verified isolation.
TEST_CLIENT_A_EMAIL=
TEST_CLIENT_A_PASSWORD=
TEST_CLIENT_B_EMAIL=
